# Backend Connection
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="your-next-auth-secret-key"

# OAuth/OIDC provider credentials (server-only; never use NEXT_PUBLIC_ names)
GOOGLE_CLIENT_ID="your-google-web-client-id"
GOOGLE_CLIENT_SECRET="your-google-web-client-secret"
AZURE_AD_CLIENT_ID="your-microsoft-entra-application-id"
AZURE_AD_CLIENT_SECRET="your-microsoft-entra-client-secret-value"
AZURE_AD_TENANT_ID="common"
# Generate independently from NEXTAUTH_SECRET, JWT_SECRET, and GOOGLE_API_KEY.
OAUTH_BRIDGE_SECRET="shared-server-only-secret-between-vercel-and-render"
# GOOGLE_API_KEY (Gemini) is unrelated; do not use it for OAuth.
